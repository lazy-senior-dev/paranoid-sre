Ticket: PLAT-280 "Autoscale the search service between 3 and 10 replicas"

diff --git a/deploy/k8s/search-hpa.yaml b/deploy/k8s/search-hpa.yaml
--- /dev/null
+++ b/deploy/k8s/search-hpa.yaml
@@ -0,0 +1,16 @@
+apiVersion: autoscaling/v2
+kind: HorizontalPodAutoscaler
+metadata:
+  name: search
+  namespace: search
+spec:
+  scaleTargetRef:
+    apiVersion: apps/v1
+    kind: Deployment
+    name: search
+  minReplicas: 3
+  maxReplicas: 10
+  metrics:
+    - type: Resource
+      resource:
+        name: cpu
+        target: { type: Utilization, averageUtilization: 70 }
diff --git a/deploy/k8s/search-pdb.yaml b/deploy/k8s/search-pdb.yaml
--- /dev/null
+++ b/deploy/k8s/search-pdb.yaml
@@ -0,0 +1,10 @@
+apiVersion: policy/v1
+kind: PodDisruptionBudget
+metadata:
+  name: search
+  namespace: search
+spec:
+  minAvailable: 50%
+  selector:
+    matchLabels:
+      app: search
